# Copilot LLM settings (Phase 95+). Copy to `.env` and edit locally.
# Never commit a real `.env` — `.gitignore` excludes it.
# Next.js must NOT get these keys via NEXT_PUBLIC_*.
#
# Phase 98 AI Insight (report stage) uses this same provider when
# pipeline.yaml has `copilot.ai_insight.enabled: true`. Chat dual-gate
# (COPILOT_ENABLED + copilot.enabled) is NOT required for Insight.

# Dual-gate with pipeline.yaml `copilot.enabled` — both must be true for chat.
COPILOT_ENABLED=false

# Which backend: ollama | openai_compat | gemini
COPILOT_PROVIDER=ollama

# Model id for the chosen provider:
# - ollama example:        qwen2.5:14b
# - openai_compat example: gpt-4o-mini
# - gemini:                auto   ← prefers gemini-flash-latest, then falls back
#                          on HTTP 404/503/429 to the next listed model
#                          or pin e.g. gemini-flash-latest
COPILOT_MODEL=qwen2.5:14b
# Overall budget (Gemini uses shorter per-attempt timeouts + fallbacks inside this).
COPILOT_TIMEOUT_SECONDS=120

# --- Example: Gemini (uncomment / set these instead of the ollama block above) ---
# COPILOT_ENABLED=true
# COPILOT_PROVIDER=gemini
# COPILOT_MODEL=auto
# GEMINI_API_KEY=your-key-here

# Local Ollama (used when COPILOT_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required when COPILOT_PROVIDER=openai_compat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Required when COPILOT_PROVIDER=gemini (GOOGLE_API_KEY also accepted)
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
