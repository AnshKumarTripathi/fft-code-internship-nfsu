# DuckDB warehouse (regenerable; never commit)
*.duckdb
*.duckdb.wal
data/warehouse.duckdb
data/warehouse.duckdb.wal

# Local corpus drop (LogHub SSH.log, auth.log, …). Keep the empty folder.
data/raw/**
